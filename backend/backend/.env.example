# ==========================================================================
# EMORA / WELLNESS MIND AI — backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- AI ---
# Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication ---
# Secret used to sign JWTs. Use a long random string in production
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGO=HS256
# Token lifetime in minutes (default 7 days so closing the browser keeps you logged in).
JWT_EXPIRES_MINUTES=10080

# Application ID used to namespace user data in storage.
APP_ID=emora-app

# --- Storage ---
# Storage backend: firestore | sqlite | memory
#   firestore  -> real Google Firestore (requires credentials below).
#   sqlite     -> persistent local file database (default when Firestore is
#                 not configured). Survives restarts. Stored in DATA_DIR.
#   memory     -> DEV ONLY. In-memory; data is LOST on restart.
# Leave empty to auto-select (Firestore when available, else sqlite).
STORAGE_BACKEND=

# Directory used by the sqlite backend (defaults to backend/backend/data).
DATA_DIR=

# --- Firestore (optional, only needed if using real Google Firestore) ---
# Path to a Google service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROJECT_ID=

# --- Google Sign-In (OAuth) ---
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:9000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/google/callback
